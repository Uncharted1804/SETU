# ==============================================================================
# Environment Configuration & API Keys
# ==============================================================================
# Copy this file to .env and configure your secret keys.
# DO NOT commit .env to version control.

# Application Environment (development, staging, production)
ENVIRONMENT=development
LOG_LEVEL=INFO

# Common API Keys (Uncomment and populate as needed for hackathon tasks)
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=

# Google Service / OAuth Credentials (if interacting with Sheets/Slides)
# GOOGLE_APPLICATION_CREDENTIALS=credentials.json
