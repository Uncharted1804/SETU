# SETU environment.  Copy to .env and adjust, or export these in your shell.
# The launch scripts (scripts/dev.ps1, scripts/dev.sh) set the common ones for you.
#
# NOTHING here causes a download. Models, wheels, the embedding cache and the
# sandbox image are all staged ahead of time (see docs/SETUP_KIT.md).

# --- THE switch ------------------------------------------------------------
# 1 (default) = mock mode: deterministic fixtures, no GPU, no Ollama, no Docker,
#               no Tesseract, no embedding download, no knowledge base.
# 0           = real mode: every component must actually be present.
SETU_MOCK_MODE=1

# --- Model serving ---------------------------------------------------------
# MUST be loopback. The backend refuses to start otherwise (blueprint 12.7).
OLLAMA_HOST=127.0.0.1:11434
# Seconds to wait for one inference before giving up.
SETU_OLLAMA_TIMEOUT=120

# Set these in the Ollama SERVICE environment, not here (see scripts/00_env_setup.ps1):
#   OLLAMA_MAX_LOADED_MODELS=1
#   OLLAMA_NUM_PARALLEL=1
#   OLLAMA_KEEP_ALIVE=10m
#   OLLAMA_FLASH_ATTENTION=1

# --- Paths -----------------------------------------------------------------
# The agent's ONLY writable directory. Every filesystem tool is jailed to it.
SETU_WORKSPACE=./data/workspace
# Deliberately OUTSIDE the workspace: no registered tool can reach the audit log.
SETU_AUDIT_PATH=./logs/audit.jsonl
# Embedded Chroma store (created by P3's ingestion, not at startup).
SETU_KB_PATH=./data/chroma
# Only set this if you are serving a dist built somewhere else.
# SETU_FRONTEND_DIST=./frontend/dist

# --- Sandbox ---------------------------------------------------------------
# Built ahead of time: docker build -t setu-sandbox:py311 sandbox/
# or offline:          docker load -i vendor/setu-sandbox-py311.tar
SETU_SANDBOX_IMAGE=setu-sandbox:py311
SETU_SANDBOX_TIMEOUT=15

# --- Topology --------------------------------------------------------------
# UNSET  = single-laptop mode, binds 127.0.0.1, two-way netwatch split.
# SET    = LAN mode, binds 0.0.0.0, four-way classification.
# Set it from the subnet you ACTUALLY observe at the venue - a hotspot hands out
# a different range every session. An INVALID value is a hard startup failure,
# never a silent fallback.
# SETU_TRUSTED_SUBNET=192.168.50.0/24

# --- Dev-mode CORS (P5's machine only) -------------------------------------
# The real deployment installs NO CORS middleware: the browser loads the UI from
# the same origin it calls, so no cross-origin request exists.
# Both variables are required. SETU_DEV_MODE=1 without SETU_DEV_ORIGINS installs
# nothing and logs a warning (fail closed). A wildcard is never installed.
# RULE: SETU_DEV_MODE and SETU_TRUSTED_SUBNET are never both set on the demo box.
# SETU_DEV_MODE=1
# SETU_DEV_ORIGINS=http://localhost:5173
