# SETU backend top-level dependencies.
#
# This file lists INTENT. The reproducible artifact is requirements-lock.txt,
# generated by 04_cache_wheels.ps1 via pip-compile. Blueprint F13: wildcards
# do not reproduce an offline build; only a hash-pinned lock does.
#
# Do not pip install from this file on the demo machine. Use:
#   pip install --no-index --find-links vendor/wheels -r requirements-lock.txt

# --- API and streaming (section 11, F12: POST task then GET SSE) ---
fastapi
uvicorn[standard]
sse-starlette
python-multipart
pydantic>=2
pyyaml

# --- Model access ---
ollama
httpx

# --- Document intelligence, tier D1 (section 7.2) ---
pymupdf              # digital PDF text + page rasterization
python-docx          # DOCX read and template-based artifact generation
openpyxl             # XLSX read/write, host side
pillow               # image handling before OCR/VLM

# --- Document intelligence, tier D2: OCR ---
pytesseract          # wrapper only; the Tesseract binary is installed separately
opencv-python-headless   # deskew, contrast, denoise
numpy

# --- Retrieval (section: CPU embeddings, embedded vector index, no GraphRAG) ---
sentence-transformers
torch                # CPU build is sufficient for bge-small
chromadb

# --- Verification and security ---
jsonschema           # structured-output and schema validation
rapidfuzz            # citation matching against source spans
psutil               # process-scoped socket monitoring (netwatch.py, section 12.3)

# --- Testing ---
pytest
pytest-asyncio
